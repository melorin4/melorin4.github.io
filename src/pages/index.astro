---
// @ts-expect-error Astro/Vite resolves the global stylesheet at build time.
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Personal portfolio" />
    <title>portfolio</title>
  </head>
  <body>
    <nav class="top-bar" aria-label="Primary navigation">
      <a href="/">home</a>
      <a href="/projects/">projects</a>
      <a href="/resume/">resume</a>
    </nav>

    <main class="layout home-layout">
      <aside class="side-box profile-box">
        <div class="profile-heading">
          <span class="profile-star" aria-hidden="true">*</span>
          <h1>lorin</h1>
        </div>
        <p class="profile-role">software engineering student</p>
        <dl class="profile-details">
          <div>
            <dt>age</dt>
            <dd>22</dd>
          </div>
          <div>
            <dt>pronouns</dt>
            <dd>she/her</dd>
          </div>
          <div>
            <dt>based in</dt>
            <dd>uk/tr</dd>
          </div>
        </dl>
      </aside>

      <section class="main-box showcase-box">
        <header class="showcase-intro">
          <h2>my links!</h2>
        </header>

        <div class="showcase-grid">
          <article class="hover-card card-yellow">
            <span class="card-number">01</span>
            <h3>thingamabobs</h3>
            <p>coming soon</p>
          </article>
          <a class="hover-card card-green" href="https://github.com/melorin4" target="_blank" rel="noreferrer">
            <span class="card-number">02</span>
            <h3>personal corner</h3>
            <p>my more personal website is coming soon as well</p>
          </a>
          <a class="hover-card card-blue" href="" target="_blank" rel="noreferrer">
            <span class="card-number">03</span>
            <h3>github</h3>
            <p>check out my github! </p>
          </a>
          <a class="hover-card card-pink" href="" target="_blank" rel="noreferrer">
            <span class="card-number">04</span>
            <h3>clock</h3>
            <p>tick tock</p>
          </a>
        </div>

        <footer class="site-footer">
          <p>built with astro + html/css, hosted on github pages.</p>
        </footer>
      </section>
    </main>
  </body>
</html>
